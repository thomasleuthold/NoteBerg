{
  "name": "onejournal",
  "version": "0.4.2",
  "description": "A note-taking app supporting handwritten notes, text, and drawings",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "proxy": "node proxy-server.js",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "format-check": "biome format ./src",
    "check": "biome check --write --unsafe ./src",
    "sync-version": "node sync-version.js",
    "version": "npm run sync-version && git add src-tauri/tauri.conf.json"
  },
  "keywords": [
    "notes",
    "handwriting",
    "stylus",
    "webdav",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^1.6.0",
    "cors": "^2.8.5",
    "eslint": "^8.57.0",
    "express": "^4.18.2",
    "jsdom": "^24.1.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.2.5",
    "vite": "^5.1.4",
    "vite-plugin-singlefile": "^2.0.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "idb": "^8.0.0",
    "pdfjs-dist": "^5.4.530",
    "perspective-transform": "^1.1.3"
  }
}
