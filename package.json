{
  "name": "noteberg",
  "version": "0.5.39-rc.1",
  "build": 1,
  "description": "A note-taking app supporting handwritten notes, text, and drawings",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:nextcloud": "vitest run --config vitest.config.nextcloud.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "proxy": "node proxy-server.js",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "format-check": "biome format ./src",
    "check": "biome check --write --unsafe ./src",
    "build:nextcloud": "cross-env VITE_PLATFORM=nextcloud vite build",
    "dev:nextcloud": "cross-env VITE_PLATFORM=nextcloud vite build --watch",
    "sync-version": "node sync-version.js",
    "version": "node sync-version.js && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml appinfo/info.xml package.json"
  },
  "keywords": [
    "notes",
    "handwriting",
    "stylus",
    "webdav",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.5",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.8.3",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "dompurify": "^3.4.9",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.8",
    "idb": "^8.0.3",
    "jquery": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "perspective-transform": "^1.1.3",
    "trumbowyg": "^2.31.0"
  }
}
