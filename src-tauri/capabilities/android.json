{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android",
  "description": "Android-only permissions",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    }
  ]
}
