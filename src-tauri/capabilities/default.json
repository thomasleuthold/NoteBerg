{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for NoteBerg",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "NoteBerg.Recognition",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://localhost/**"
        },
        {
          "url": "http://localhost:*/**"
        },
        {
          "url": "http://localhost:5089/**"
        },
        {
          "url": "http://*:5000/**"
        }
      ]
    }
  ]
}
