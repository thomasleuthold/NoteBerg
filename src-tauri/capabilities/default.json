{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for oneJournal",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux", "android"],
  "permissions": [
    "core:default",
    "http:default",
    "opener:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "args": true
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        }
      ]
    }
  ]
}
