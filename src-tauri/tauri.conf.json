{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NoteBerg",
  "version": "0.5.30",
  "identifier": "eu.noteberg.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteBerg",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data: mediastream:; connect-src 'self' http: https:; script-src 'self' blob: 'unsafe-eval'; style-src 'self' 'unsafe-inline'; media-src 'self' blob: data: mediastream:;",
      "capabilities": [
        "default",
        "android"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Note-taking with handwriting support",
    "longDescription": "A note-taking app supporting handwritten notes, text, and drawings",
    "licenseFile": "licenses/license.rtf",
    "windows": {
      "wix": {
        "bannerPath": "icons/msi2.bmp",
        "dialogImagePath": "icons/msi1.bmp"
      }
    }
  }
}